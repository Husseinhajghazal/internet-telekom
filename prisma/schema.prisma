generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  NOT_COMPLETED
  NEW
  UNDER_REVIEW
  UNDER_OBSERVATION
  DELAYED
  REJECTED
  COMPLETED
}

model Application {
  id                  String            @id @default(cuid())
  appIndex            Int               @unique
  status              ApplicationStatus @default(NOT_COMPLETED)
  step                Int               @default(1)
  name                String
  newName             String?
  phone               String
  hasInternet         String?
  serviceType         String?
  contractPreference  String?
  selectedService     String?
  selectedPackage     String?
  phone2              String?
  newPhone            String?
  nationalNumber      String?
  birthDate           String?
  addressCode         String?
  address             String?
  newAddress          String?
  originalAddress     Boolean           @default(true)
  originalAddressText String?
  note                String?
  invoiceFileUrl      String?
  internetCompany     String?
  subscriptionNo      String?
  lastInvoiceAmount   String?
  selectedInquiry     String?
  newNationalNumber   String?
  newOriginalAddress  Boolean           @default(true)
  newOriginalAddressText String?
  newAddressCode      String?
  noContractTechType  String?
  adminNote           String?
  completedAt         DateTime?
  delayedUntil        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  isDeleted           Boolean           @default(false)
  notes               Note[]
}

model Note {
  id            String      @id @default(cuid())
  text          String
  adminName     String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
