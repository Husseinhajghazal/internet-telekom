generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  NOT_COMPLETED
  NEW
  UNDER_REVIEW
  UNDER_OBSERVATION
  DELAYED
  REJECTED
  COMPLETED
  TECHNICAL_PROBLEM
  TRYING_TO_PERSUADE
  ACTIVATED
  WAITING_FOR_PORT
  UNDER_INSTALLATION
  UNDER_FREEZING
  UNDER_CANCELING
  UNDER_CHANGE
  UNDER_TRANSFER
  UNDER_RENEW
}

enum WhatsappStatus {
  NOT_ADDED
  ADDED
}

model Application {
  id                  String            @id @default(cuid())
  appIndex            Int               @unique
  status              ApplicationStatus @default(NOT_COMPLETED)
  step                Int               @default(1)
  name                String
  newName             String?
  phone               String
  hasInternet         String?
  serviceType         String?
  contractPreference  String?
  selectedService     String?
  selectedPackage     String?
  phone2              String?
  newPhone            String?
  nationalNumber      String?
  birthDate           String?
  addressCode         String?
  address             String?
  newAddress          String?
  originalAddress     Boolean           @default(true)
  originalAddressText String?
  note                String?
  invoiceFileUrl      String?
  internetCompany     String?
  subscriptionNo      String?
  lastInvoiceAmount   String?
  selectedInquiry     String?
  newNationalNumber   String?
  newOriginalAddress  Boolean           @default(true)
  newOriginalAddressText String?
  newAddressCode      String?
  noContractTechType  String?
  electronicApproval  Boolean           @default(false)
  approvalViaShipping Boolean           @default(false)
  paidByUserName      Boolean           @default(false)
  paidByName          String?
  discountCount       String?
  adminNote           String?
  adminNoteViewed     Boolean           @default(false)
  completedAt         DateTime?
  delayedUntil        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lastUpdatedBy       String?
  createdBy           String?
  isDeleted           Boolean           @default(false)
  whatsappStatus      WhatsappStatus    @default(NOT_ADDED)
  reminderSent        Boolean           @default(false)
  notes               Note[]
  Review              Review?
  logs                ApplicationLog[]
}

model Note {
  id            String      @id @default(cuid())
  text          String
  adminName     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      String   @default("EMPLOYEE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating        Int      @default(5)
  comment       String
  service       String?
  isApproved    Boolean  @default(false)
  applicationId String?  @unique
  Application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationLog {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  adminName     String
  action        String      // "CREATE", "UPDATE", "STATUS_CHANGE", "DELETE", "RESTORE"
  changes       Json?       // { field: { old: any, new: any } }
  createdAt     DateTime    @default(now())
}
